give @s written_book[custom_data={"gui":"limbo.secret_1"},item_model="icon/limbo_book",written_book_content={pages:[["",{text:"Between life and death lies Limbo, a fractured realm adrift in shadows and silence.",color:"#558B2F"},{text:"\n"},{text:"\n"},{text:"Time moves like a whisper here, broken and uncertain, where forgotten souls wander endlessly, severed from memory and fate.",color:"#FFA119"}],["",{text:"No gods rule this place. No laws hold.",color:"#5C0505"},{text:"\n"},{text:"\n"},{text:"Limbo is shaped by the minds of the lost — dreams, regrets, and fears congeal into landscapes both haunting and surreal.",color:"#0069AD"},{text:"\n"},{text:"\n"},{text:"Some seek escape. Others forget why they ever tried.",color:"#C42430"}],["",{text:"What does it matter? I finally found the peace I longed for.",color:"#DC5F30"},{text:"\n"},{text:"\n"},{text:"Although something stirs in the stillness — an echo, a presence. Something ancient. Watching. Waiting.",color:"#891E2B"}]],title:"Limbo",author:"Unknown"},enchantment_glint_override=false]